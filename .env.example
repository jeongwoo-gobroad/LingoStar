PORT=8787
APP_ORIGIN=http://localhost:8787
CORS_ALLOWED_ORIGINS=http://localhost:8787,https://chatgpt.com
WIDGET_CONNECT_DOMAINS=http://localhost:8787
WIDGET_RESOURCE_DOMAINS=http://localhost:8787

# Local development defaults. Use firestore on Cloud Run.
LINGOSTAR_STATE_STORE=memory
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_COLLECTION=lingostar_states

# OAuth is normally disabled for local development and enabled in production.
LINGOSTAR_AUTH_REQUIRED=0
OAUTH_ISSUER=
OAUTH_AUTHORIZATION_SERVERS=
OAUTH_JWKS_URL=
OAUTH_AUDIENCE=http://localhost:8787
OAUTH_SCOPES=lingostar.read lingostar.write lingostar.audio
OAUTH_REQUEST_SCOPES=lingostar.read lingostar.write lingostar.audio
OAUTH_CLIENT_ID=
OAUTH_SCOPE_MODE=none
OAUTH_VALIDATE_CLIENT_ID=true
OAUTH_ALLOW_SCOPELESS_TOKENS=false
OAUTH_RESOURCE_DOCUMENTATION=http://localhost:8787/privacy-policy.html

# Optional server-side audio fallback. Keep false unless the secret is configured.
IS_AI_FALLBACK=false
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_FORMAT=mp3

# Feedback admin page.
FEEDBACK_ADMIN_ID=
FEEDBACK_ADMIN_PASSWORD=

# ChatGPT Apps domain verification.
OPENAI_APPS_CHALLENGE_TOKEN=
